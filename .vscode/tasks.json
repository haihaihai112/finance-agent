{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "金融项目：启动", "type": "process",
      "command": "pwsh",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/scripts/start.ps1"],
      "options": {"cwd": "${workspaceFolder}"}, "problemMatcher": []
    },
    {
      "label": "金融项目：离线诊断", "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["scripts/doctor.py"], "options": {"cwd": "${workspaceFolder}"}, "problemMatcher": []
    },
    {
      "label": "金融项目：代码验收", "type": "process",
      "command": "pwsh",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/scripts/verify.ps1"],
      "options": {"cwd": "${workspaceFolder}"}, "problemMatcher": [], "group": "test"
    }
  ]
}
