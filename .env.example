# DeepSeek：仅本地配置；空密钥时明确使用规则路由。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
LLM_ENABLED=true
# stdio = 真实MCP SDK协议；inprocess = 同业务直接调用，便于调试。
MCP_TRANSPORT=stdio
# Per-process OCR bound; cache/authorization/file IO runs in worker threads.
OCR_MAX_CONCURRENCY=2
# 留空默认项目 data/runtime/finance.db（SQLite）。
DATABASE_URL=
# MySQL示例，先按docs/mysql.md启动并设置本地密码：
# DATABASE_URL=mysql+pymysql://finance:YOUR_PASSWORD@127.0.0.1:3306/finance_agents?charset=utf8mb4
# 可选覆盖：FINANCE_DATA_DIR=C:/your/project/data/runtime
MARKET_INSTRUMENT_IDS=510300
# docker-compose仅用于本机演示，密码在本地.env中填写。
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
# Explicit dedicated test database ONLY; integration tests create synthetic rows.
MYSQL_TEST_URL=
